---
import '../styles/global.css';
import { site } from '../../site.config';
import { url } from '../lib';

interface Props {
  title?: string;
  description?: string;
  tab?: string;
  wide?: boolean;
}

const { title, description = site.description.replace(/\s*\n\s*/g, ' '), tab, wide = false } = Astro.props;
const pageTitle = title ? `${title} — ${site.title}` : site.title;
const path = Astro.url.pathname;
const current = tab ?? site.tabs.find((t) => path.startsWith(url(t.href)))?.key;

const { body, notes } = site.fonts;
const families = [body, notes]
  .filter((f, i, all) => all.findIndex((x) => x.name === f.name) === i)
  .map((f) => `family=${f.name.replaceAll(' ', '+')}:wght@${f.weights}`)
  .join('&');
const fontsHref = `https://fonts.googleapis.com/css2?${families}&display=swap`;
const fontVars = `--body-font: '${body.name}'; --notes-font: '${notes.name}';`;
---

<!doctype html>
<html lang={site.lang} style={fontVars}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('/icons/apple-touch-icon.png')} />
    <link rel="manifest" href={url('/manifest.webmanifest')} />
    <meta name="theme-color" content={site.app.themeColor} />
    <meta name="apple-mobile-web-app-title" content={site.app.shortName || site.title} />
    <meta name="mobile-web-app-capable" content="yes" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontsHref} />
  </head>
  <body>
    <div class:list={['page', { wide }]}>
      <header class="site-header">
        <div class="profile">
          {
            site.avatar && (
              <a class="avatar" href={url('/')} tabindex="-1">
                <img src={url(site.avatar)} alt="" width="88" height="88" />
              </a>
            )
          }
          <div class="profile-text">
            <a class="site-title" href={url('/')}>{site.title}</a>
            {site.description && <p class="site-desc">{site.description}</p>}
          </div>
        </div>
        <nav class="tabs" aria-label="分頁">
          {
            site.tabs.map((t) => (
              <a href={url(t.href)} aria-current={current === t.key ? 'page' : undefined}>
                {t.label}
              </a>
            ))
          }
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        {site.footer || `© ${new Date().getFullYear()} ${site.author}`}
      </footer>
    </div>
  </body>
</html>
