---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { published, formatDate, url } from '../../lib';

export async function getStaticPaths() {
  const posts = await published('blog');
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.description}>
  <article>
    <header>
      <h1>{post.data.title}</h1>
      <time class="meta" datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
    </header>
    <div class="prose" data-quote>
      <Content />
    </div>
  </article>
  <a class="back meta" href={url('/blog/')}>返回</a>
</Base>

<style>
  header {
    margin-bottom: 3rem;
  }
  h1 {
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.5;
    margin: 0 0 0.5rem;
  }
  .back {
    display: inline-block;
    margin-top: 4rem;
  }
  .back:hover {
    color: var(--fg);
  }
</style>
