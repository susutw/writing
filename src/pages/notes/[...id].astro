---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { published, formatDateTime, url } from '../../lib';

export async function getStaticPaths() {
  const notes = await published('notes');
  return notes.map((note) => ({ params: { id: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content } = await render(note);
const stamp = formatDateTime(note.data.date);
---

<Base title={stamp} tab="notes">
  <article>
    <div class="prose note-text" data-quote>
      <Content />
    </div>
    <time class="meta" datetime={note.data.date.toISOString()}>{stamp}</time>
  </article>
  <a class="back meta" href={url('/notes/')}>返回</a>
</Base>

<style>
  time {
    display: block;
    margin-top: 0.9rem;
  }
  .back {
    display: inline-block;
    margin-top: 4rem;
  }
  .back:hover {
    color: var(--fg);
  }
</style>
