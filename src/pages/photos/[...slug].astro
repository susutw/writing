---
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { published, slug, formatDate, url } from '../../lib';

export async function getStaticPaths() {
  const posts = await published('photos');
  return posts.map((post) => ({ params: { slug: slug(post.id) }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
// 分享引文圖片時的底圖（第一張照片）
const quoteBg = await getImage({ src: post.data.images[0], width: 1440, format: 'jpg' });
---

<Base title={post.data.title ?? formatDate(post.data.date)} tab="photos">
  <article>
    <div class="images">
      {
        post.data.images.map((img, i) => (
          <Image
            src={img}
            alt={post.data.title ?? ''}
            width={1200}
            loading={i === 0 ? 'eager' : 'lazy'}
          />
        ))
      }
    </div>
    {post.data.title && <h1>{post.data.title}</h1>}
    <div class="prose" data-quote data-quote-bg={quoteBg.src}>
      <Content />
    </div>
    <time class="meta" datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
  </article>
  <a class="back meta" href={url('/photos/')}>返回</a>
</Base>

<style>
  .images {
    display: grid;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }
  h1 {
    font-size: 1.05rem;
    font-weight: 600;
    margin: 0 0 1rem;
  }
  time {
    display: block;
    margin-top: 1.5rem;
  }
  .back {
    display: inline-block;
    margin-top: 4rem;
  }
  .back:hover {
    color: var(--fg);
  }
</style>
