---
import Base from '../layouts/Base.astro';
import BlogList from '../components/BlogList.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import NoteFeed from '../components/NoteFeed.astro';
import PodcastList from '../components/PodcastList.astro';
import { site } from '../../site.config';
---

<Base tab={site.home}>
  {site.home === 'blog' && <BlogList />}
  {site.home === 'photos' && <PhotoGrid />}
  {site.home === 'notes' && <NoteFeed />}
  {site.home === 'podcast' && <PodcastList />}
</Base>
